# Target chain (1 = mainnet, 11155111 = sepolia)
NEXT_PUBLIC_CHAIN_ID=1

# Client ID (programa de client incentives da Nouns DAO). Vazio = sem client ID.
NEXT_PUBLIC_CAMP_CLIENT_ID=

# URL HTTP(S) de um JSON-RPC Ethereum para NEXT_PUBLIC_CHAIN_ID (tem precedência).
# Fica público no browser: use restrição de domínio no provedor quando houver.
NEXT_PUBLIC_RPC_URL=
# Fallback quando NEXT_PUBLIC_RPC_URL está vazio.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Reown/WalletConnect Cloud project ID (gratuito). Vazio desabilita o conector WalletConnect.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Subgraphs públicos da Nouns DAO na Goldsky
NOUNS_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_clnbcoajmebxn33wdbt98f439/subgraphs/nouns-mainnet/1.0.0/gn
PROPDATES_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_clnbcoajmebxn33wdbt98f439/subgraphs/nouns-propdates/1.0.0/gn

# Opcionais (free tier). Etherscan: decodificação de contratos. Tenderly: simulação de props.
ETHERSCAN_API_KEY=
TENDERLY_API_KEY=
TENDERLY_PROJECT_SLUG=

# Segredo da sessão SIWE. Gere com `openssl rand -base64 32`
SESSION_SEAL_SECRET=

# Listas opcionais de endereços (separados por vírgula) com acesso a features canary/beta
CAMP_CANARY_ACCOUNTS=
CAMP_BETA_ACCOUNTS=

# Só em desenvolvimento local. Na Vercel ficam vazios: o next.config usa
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL (acompanha o domínio custom).
# APP_HOST deve bater com window.location.host (verificação de assinaturas SIWE).
# APP_HOST=localhost:3100
# APP_PRODUCTION_URL=http://localhost:3100
