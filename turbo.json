{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "nouns-camp#build": {
      "dependsOn": ["^build"],
      "env": [
        "APP_HOST",
        "APP_PRODUCTION_URL",
        "CAMP_BETA_ACCOUNTS",
        "CAMP_CANARY_ACCOUNTS",
        "ETHERSCAN_API_KEY",
        "NOUNS_SUBGRAPH_URL",
        "PROPDATES_SUBGRAPH_URL",
        "SESSION_SEAL_SECRET",
        "TENDERLY_API_KEY",
        "TENDERLY_PROJECT_SLUG"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["CI_LINT"]
}
